{
  "name": "@maskviva/ambi-node",
  "version": "0.2.1",
  "description": "Node.js binding for Ambi — a high-perf, cross-platform AI Agent framework built in Rust",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "lib/llama.js",
    "lib/llama.d.ts",
    "examples/",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maskviva/Ambi.git"
  },
  "homepage": "https://github.com/Maskviva/Ambi",
  "keywords": [
    "llm",
    "agent",
    "ai",
    "napi-rs",
    "openai",
    "llama"
  ],
  "author": "Ambi Contributors",
  "license": "Apache-2.0",
  "engines": {
    "node": ">= 18"
  },
  "napi": {
    "binaryName": "ambi-node",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl"
    ]
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release && node -e \"const fs=require('fs');const p='index.d.ts';let c=fs.readFileSync(p,'utf8');if(!c.includes('type JsonValue')){fs.writeFileSync(p,'type JsonValue = any;\\n'+c)}\"",
    "prepublishOnly": "npx napi prepublish -t npm",
    "version": "npx napi version"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.6.2"
  },
  "optionalDependencies": {
    "@maskviva/ambi-node-linux-x64-gnu": "0.2.1",
    "@maskviva/ambi-node-win32-x64-msvc": "0.2.1",
    "@maskviva/ambi-node-linux-arm64-gnu": "0.2.1",
    "@maskviva/ambi-node-linux-arm64-musl": "0.2.1"
  },
  "dependencies": {
    "node-llama-cpp": "^3.18.1"
  }
}